# MiniMax-H3 / 4x RTX 5090 (32 GiB) best-practice launch settings.
#
# Prerequisites:
#   * transformer/ carries the int8 ConvRot single-file checkpoint
#     (minimax_h3_fl2va_int8_convrot.safetensors) instead of the bf16 shards,
#     with the original config.json kept alongside it.
#   * the lazy-codec stage fix from hudi/h3-vae-double-load is applied.
#
# Measured: 512p/4 steps 16.07 s (3.735 req/min), 768p/8 steps 46.15 s (1.300 req/min).

MODEL_PATH=/work/models/MiniMax-H3
MODEL_VARIANT=fl2va

# 4 ranks, one replica, no sequence parallelism.
NUM_GPUS=4
TP_SIZE=4
SP_DEGREE=1
PERFORMANCE_MODE=speed

# Keep the allocator from fragmenting the 26.7 GiB int8 footprint.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# Server flags.
ARGS=(
  --model-path "${MODEL_PATH}"
  --model-variant "${MODEL_VARIANT}"
  --num-gpus "${NUM_GPUS}"
  --tp-size "${TP_SIZE}"
  --sp-degree "${SP_DEGREE}"
  --performance-mode "${PERFORMANCE_MODE}"
  # int8 ConvRot transformer weights.
  --quantization convrot_int8
  # Keep a pinned host snapshot of the encoder: removes the per-request D2H.
  --component-residency text_encoder=snapshot-offload
  # The VAE stays CPU-offloaded; making it resident does not fit.
  --vae-cpu-offload
)

# Reference invocation:
#
#   PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True \
#   sglang serve "${ARGS[@]}" \
#       --host 0.0.0.0 --port 30001 --master-port 30015 --scheduler-port 5573
