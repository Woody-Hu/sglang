# fasth3 —— 规范启动配置（SOTA · 单卡 A100 · MiniMax FastH3 4 步视频生成）
#
# 采纳方案（默认 / 无损）= OPT-1：`--layerwise-offload-components dit text_encoder`
#   （仅 DiT 与文本编码器逐层 offload，VAE 组常驻）——e2e 149.75 → 84.96 s（−43.3%），
#   输出 mp4 与冻结基线 MD5 bit-exact。
# 快速档（可选 / 有损）= 定制 A100 Triton VSA 稀疏内核（capability-gated sm80 裸指针路径）
#   `--attention-backend video_sparse_attn_h3` ——e2e 59.59 s（−29.9%），PSNR 14.65 dB（超 §6）。
# 备选有损档 = kitchen_int8 量化——e2e 76.87 s（−9.5%），PSNR 27.55 dB（超 §6）。
#
# 本文件 = 统一旋钮单一真相源；与 vendor best-practice worktree 内 `fasth3-a100-best-practice/launch.env` 一致。
#
# 运行方式（远程宿主 143）：见 tasks/fasth3/scripts/{run_fasth3.sh, deploy_fasth3_service.sh}
#   一次性 run：  bash scripts/orchestrate_remote.sh <tag> smoke '--layerwise-offload-components dit text_encoder'
#   常驻服务：    bash scripts/deploy_fasth3_service.sh   （容器名 hudi-fasth3-serve，端口 8080）

# ---- 镜像 / 引擎 ----
IMAGE=m.daocloud.io/docker.io/lmsysorg/sglang:v0.5.17-cu129   # 宿主侧注入；v0.5.20 源码 overlay（editable）
ENGINE="SGLang fork main + 本任务 overlay（FastH3PipelineConfig）"  # 引擎 + 基点
OVERLAY_REGISTRY=/work/configs/overlay_registry.json          # 容器视角路径（宿主路径会 FileNotFoundError）

# ---- 模型 ----
MODEL_PATH=/work/models/FastVideo-FastH3-4-step-Preview-v1-VSA-DataFree   # 容器内路径
MODEL_TYPE=diffusion                                          # FastVideo 导出目录无 model_index.json → 必须显式指定

# ---- 采样（固定测试集，AGENTS.md §6）----
CONFIG=/work/configs/fasth3_baseline_5s.json                  # task=t2va / short_edge=768 / aspect=16:9 / 5.0s / 5 步
TASK=t2va
SHORT_EDGE=768
ASPECT_RATIO=16:9
DURATION_SECONDS=5.0
NUM_INFERENCE_STEPS=5                                         # 有效去噪步 = 4（DMD2 4 步蒸馏）
SOURCE_FPS=24
SEED=1000
WARMUP_MODE=request
SERVED_MODEL_NAME=fasth3-4step

# ---- 采纳旋钮（默认 = 无损 OPT-1）----
ATTENTION_BACKEND=fa                                          # 默认 dense FlashAttention（SM80 FlashAttnFwdSm80）
LAYERWISE_OFFLOAD_COMPONENTS="dit text_encoder"               # OPT-1 核心：VAE 组常驻，免逐请求重流式
QUANT=bf16                                                    # 默认无损；kitchen_int8 为可选有损档
TORCH_COMPILE=false                                           # 实测 OOM / +33.7% 慢 → 弃

# ---- 可选有损档（须显式接受；均超 AGENTS.md §6 质量门槛）----
# 最快档（-29.9%，PSNR 14.65 dB）：
#   ATTENTION_BACKEND=video_sparse_attn_h3
# 备选（-9.5%，PSNR 27.55 dB）：
#   QUANT=kitchen_int8            # 依赖 comfy_kitchen 自源码构建（COMFY_CUDA_ARCHS=80）

# ---- GPU / 服务 ----
NUM_GPUS=1
PORT=8080
CUDA_VISIBLE_DEVICES=0        # 本任务历史实验用 GPU 0；按当前工作区契约（2026-10-16 起）实验用 GPU 3（GPU 2 备用）

# ---- 停止方式 ----
# 一次性 run：容器 hudi-fasth3-run --rm，进程结束自动删除。
# 常驻服务：ssh xueyige@192.168.3.143 'bash /share/home/xueyige/hudi/fasth3-profile/scripts/stop_fasth3_service.sh'
#           （= docker stop hudi-fasth3-serve && docker rm hudi-fasth3-serve；GPU 随后释放）
