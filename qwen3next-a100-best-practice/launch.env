# =============================================================================
# Qwen3-Next-80B-A3B · 单卡 A100 · 最佳实践统一旋钮（SOTA 配置）
# =============================================================================
# 分支：qwen3next-gguf-a100-best（本 worktree，内部自用，不开 PR）
# 说明：本文件 = 本分支的「统一旋钮调参」单一真相源；代码改动见同目录 README.md。
#       与 tasks/qwen3next-a100/configs/launch.env 内容一致（互为镜像）。
#
# 用法（远端 143，需先把本 worktree 的 4 个 srt 文件 scp 到 /tmp）：
#   1) scp 文件清单见 README.md §2
#   2) ssh xueyige@192.168.3.143；source 本文件；bash launch_server_remote.sh
# =============================================================================

# --- 运行时（镜像 / 容器）---
IMAGE=hudi/sglang:qi21-main-cu130        # fork main (4560da58ee) + CUDA 13，transformers 5.12.1 / py3.12
NAME=q3n-sglang
PORT=31500
GPU=3                                     # 仅 GPU 3；容器内 CUDA_VISIBLE_DEVICES=3

# --- 权重（容器内路径必须 /work/...；宿主路径会被当 HF repo id 解析）---
HOST_MODEL_PATH=/share/home/xueyige/hudi/qwen3next-a100/models/Q4_K_M.gguf
CONTAINER_MODEL_PATH=/work/models/Q4_K_M.gguf
CONTAINER_TOKENIZER_PATH=/work/models

# --- 核心旋钮（P1e/P3 验证：48.4 GB 权重 + pool ≈ 60–65 GB，80 GB 内）---
LOAD_FORMAT=gguf
MEMFRACTION=0.85
CONTEXT_LENGTH=32768
MAMBA_SSM_DTYPE=bfloat16                  # mamba recurrent state 省一半显存
MAX_MAMBA_CACHE_SIZE=                     # 空 = sglang 自动（P1e 实测 max_total 495195 tok / max_req 55）
EXTRA_ARGS=                               # 见下方 MTP / MMQ 注释块

# --- MMQ 批量 MoE 后端（SOTA 核心收益，P3 验证）---
# 扩展 .so：/work/scratch/mmq_ext/hudi_gguf_moe.so（构建流程见 README.md §4）
# 缺失时 gguf.py 自动回退逐 slot vec（安全降级）。启用验证：
#   docker exec q3n-sglang python3 -c "from sglang.srt.layers.quantization import gguf; \
#     print(gguf._MMQ_MAX_EXPERTS); import hudi_gguf_moe; print(hudi_gguf_moe.version())"
#   期望：MMQ_MAX_EXPERTS= 65535 + hudi-mmq-0.4.7-exp65535
MMQ_ENABLED=1

# --- 可选：MTP/NEXTN 投机解码（bf16 mtp.* overlay，P2/P3 验证）---
# 推荐：低并发 C≤8 开启（C=1 +22%）；高并发 C=32 关闭（对齐后 ≈−11%）。
# MTP 启用后 max_running_requests 55 → 24（draft 4.23 GB 占显存）。
# MTP_OVERLAY=/work/models/mtp_overlay/model-00041-of-00041.safetensors
# EXTRA_ARGS="--speculative-algorithm NEXTN --speculative-num-steps 3 --speculative-eagle-topk 1 --speculative-num-draft-tokens 4"

# --- 补丁注入（文件替换式；本 worktree 为唯一真相源）---
PATCH_SRC=/tmp/q3n_gguf_name_maps.py      # ← srt/model_loader/gguf_name_maps.py（Qwen3-Next name-map，PR-A）
PATCH2_SRC=/tmp/q3n_qwen3_next.py         # ← srt/models/qwen3_next.py（GGUF 感知 packed loader，PR-B + PR-E）
PATCH3_SRC=/tmp/q3n_gguf_quant.py         # ← srt/layers/quantization/gguf.py（GGUFMoEMethod + MMQ 开关，PR-B/D/E）
PATCH4_SRC=/tmp/q3n_qwen3_next_mtp.py     # ← srt/models/qwen3_next_mtp.py（MTP bf16 overlay，PR-C；不启用时无害）

# --- 停止方式（teardown）---
# ssh xueyige@192.168.3.143 'docker rm -f q3n-sglang'  →  nvidia-smi -i 3 ≈ 1 MiB
