# qwenimage21 —— 规范启动配置（SOTA · 单卡 A100 · Qwen-Image 2.1）
#
# 采纳方案 = INT8 ConvRot 权重量化（kitchen_int8） + INT8 QKV 打包
#            （Q/K/V 三个 [C,C] 线性融合为「一次 ConvRot 激活量化 + 一次 IMMA GEMM」）。
# 本文件 = 统一旋钮单一真相源；与 tasks/qwenimage21/configs/launch.env 内容一致。
#
# 运行方式（远程宿主 143，一次性容器）：见 tasks/qwenimage21/scripts/run_qwenimage21.sh
#   核心命令（SOTA · main 基点镜像，代码改动已打进镜像）：
#     IMAGE=hudi/sglang:qi21-main-cu130 \
#     EXTRA_SGLANG_ARGS="--component-quantizations.transformer kitchen_int8" \
#       bash scripts/run_qwenimage21.sh <run_dir_rel>
#   备选（在 v0.5.21 发布镜像内 git apply 两个补丁，按序 0006→0007）：
#     APPLY_SGLANG_PATCHES="/work/src/patches/0006-qwen-image21-qkv-pack-offload-guard.patch \
#                          /work/src/patches/0007-qwen-image21-int8-packed-qkv.patch" \
#     PIP_PREINSTALL="comfy-kitchen==0.2.37" \
#     EXTRA_SGLANG_ARGS="--component-quantizations.transformer kitchen_int8" \
#       bash scripts/run_qwenimage21.sh <run_dir_rel>

# ---- 镜像 ----
IMAGE=hudi/sglang:qi21-main-cu130
#   = v0.5.21-cu130 基座（CUDA13 / torch2.13 / py3.12）overlay 上 fork main 基点 worktree
#     的 python/sglang（含 0008 INT8 QKV 打包）+ 预装 comfy-kitchen==0.2.37；见
#     tasks/qwenimage21/scripts/{Dockerfile.qi21-main,build_qwenimage21_main_image.sh}。
#   备选发布镜像：m.daocloud.io/docker.io/lmsysorg/sglang:v0.5.21-cu130（须自行 git apply 0006+0007）。

# ---- 模型与量化 ----
MODEL_DIR=/work/models/Qwen-Image-2.1                       # 容器内路径（宿主 /share/home/xueyige/hudi/qwen-image-profile）
QUANT=kitchen_int8                                           # --component-quantizations.transformer（main 上解析为 convrot_int8 别名）
GROUP_SIZE=256                                              # 默认；支持 16/64/256（更小=更高保真、内核更慢）
PIP_PREINSTALL=comfy-kitchen==0.2.37                        # INT8 ConvRot 融合内核依赖（cu130 容器 PyPI 直装）

# ---- 采样（固定测试集，AGENTS.md §6）----
WIDTH=1024
HEIGHT=1024
STEPS=40
GUIDANCE=1
SEED=42
WARMUP_MODE=request

# ---- 引擎旋钮（采纳状态）----
ATTENTION_BACKEND=fa          # 默认即 fa；torch_sdpa 慢 1.7% 弃、sage_attn A100 镜像未装 → 不适用
TORCH_COMPILE=false           # torch.compile 实测慢 3.33× → 弃；BCG 与 compile 互斥且 launch 非瓶颈 → 不采纳
BATCHING_MODE=dynamic         # 服务侧多请求 batching：计算受限 + GPU busy 98.6% + TOPS 不随 M 升 → 吞吐 ≈ 1.0×，不采纳

# ---- 补丁（仅 v0.5.21 发布镜像需要；main 镜像已内置 0008）----
# APPLY_SGLANG_PATCHES="/work/src/patches/0006-qwen-image21-qkv-pack-offload-guard.patch /work/src/patches/0007-qwen-image21-int8-packed-qkv.patch"

# ---- GPU 约束 ----
CUDA_VISIBLE_DEVICES=0        # 本任务历史实验用 GPU 0；按当前工作区契约（2026-10-16 起）实验用 GPU 3（GPU 2 备用）

# ---- 停止方式 ----
# 一次性 docker run --rm 容器（名 hudi-qwenimage21-run），进程结束自动删除；无常驻服务。
# 若手动清理：ssh 143 'docker rm -f hudi-qwenimage21-run'
