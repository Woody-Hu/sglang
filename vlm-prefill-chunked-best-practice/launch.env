# vlm-prefill —— 规范启动配置（SOTA · 单卡 A100 · Qwen3.5-4B VLM 多模态 prefill / 长上下文服务）
#
# 采纳方案 = 纯配置（无代码改动）：`--chunked-prefill-size 16384 --context-length 16384 --mem-fraction-static 0.80`
#   画像：多图 k=4 / 1024²（1024 visual token/图）/ 短文本 64 tok / C=8 / ctx 16384。
#   效果（B vs A，`profiles/20261017-1558_main-chunked-vitcg-ab/`）：
#     吞吐 39.16 → 42.39 tok/s（+8.25%）；e2e p50 5.211 → 4.841 s（−7.1%）；
#     TPOT p50 0.0405 → 0.019 s（−53.1%）；TTFT p95 4.818 → 4.480 s（−7.0%）；
#     TTFT p50 3.884 → 4.205 s（+8.3%，付代价：整段 prefill 不切块，首块完成更晚）。质量 PASS。
#   标的机理：收益全部来自 LLM 侧（更大 prefill chunk = 更少次、更密的 LLM forward），与 ViT 无关。
#
# 4 个实测否决杠杆（不要开）：
#   ① `--mm-attention-backend flashinfer_cudnn`  → +3.1% 吞吐但 mmmu −4pp（质量 FAIL）⇒ REJECT（保留默认 triton_attn）
#   ② `SGLANG_MM_PINNED_H2D=1`                   → HtoD pinned staging，质量无损但零收益（pageable H2D 只占 encoder 12%，同 stream 串行 bubble）⇒ NULL
#   ③ 侧流 ViT 预取（`SGLANG_MM_IMAGE_PREFETCH=1`）→ 单卡共享 GPU 上搬迁 ViT 不消除工作量，吞吐 −8.9% / TTFT p50 +21.5% ⇒ REJECT（有害）
#   ⑤ `SGLANG_VIT_ENABLE_CUDA_GRAPH=1`           → 吞吐 −2.1% 且 mmmu −4pp（graph 模式走 legacy pos-embed 数值路径）+ memfrac 0.80 首捕 OOM ⇒ REJECT
#
# 本文件 = 统一旋钮单一真相源；与 vendor best-practice worktree 内
#   `vlm-prefill-chunked-best-practice/launch.env` 内容一致。
#
# 运行方式（远程宿主 143，GPU 3）：见 tasks/vlm-prefill/scripts/launch_server_remote.sh
#   一次性/服务：shared/scripts/remote_exec.sh 'CUDA_VISIBLE_DEVICES=3 CHUNKED_PREFILL_SIZE=16384 CONTEXT_LENGTH=16384 bash /share/home/xueyige/hudi/vlm-prefill/scripts/launch_server_remote.sh'
#   停止方式：   docker rm -f vlm-sglang（脚本 scripts/stop_server_remote.sh）

# ---- 容器镜像 / 引擎基点 ----
IMAGE=hudi/sglang:qi21-main-cu130            # main 基点运行时：torch 2.13.0+cu130 / triton 3.7.1 / sglang 0.5.21 / nvcc cuda_13.0
ENGINE_BASE="SGLang fork main 4560da58ee"    # 引擎 + 基点 commit
BOOT_ENV=SGLANG_SKIP_SGL_KERNEL_VERSION_CHECK=1   # 旁路 flashinfer 版本门（仅版本 gate，非功能依赖）

# ---- 模型 / 服务 ----
MODEL_PATH=/work/models/Qwen3.5-4B           # 容器内路径（远端 /share/home/xueyige/hudi/vlm-prefill/models/Qwen3.5-4B，8.7 GiB）
SERVED_MODEL_NAME=qwen3.5-4b
NUM_GPUS=1
PORT=30000
CUDA_VISIBLE_DEVICES=3                        # 实验用 GPU 3（AGENTS.md §1.2）
CONTAINER_NAME=vlm-sglang

# ---- 采纳旋钮（默认 = SOTA，纯配置）----
CHUNKED_PREFILL_SIZE=16384                    # 核心采纳项：= ctx，整段 prefill 不切块
CONTEXT_LENGTH=16384
MEM_FRACTION_STATIC=0.80                       # 0.80 可行（ViT CG 关）；若开 ViT CUDA graph 须降到 0.70（首捕 OOM）
RANDOM_SEED=42
ENABLE_METRICS=true
MM_ATTENTION_BACKEND=triton_attn              # A100 平台默认（flashinfer_cudnn/sdpa 实测否决）
VIT_ENABLE_CUDA_GRAPH=false                   # 实测 REJECT（−2.1% 吞吐 + mmmu −4pp）
MM_PINNED_H2D=false                           # 实测 NULL（无收益）
MM_IMAGE_PREFETCH=false                       # 实测 REJECT（有害 −8.9%）

# ---- 画像边界（本 SOTA 有效范围）----
# 有效：多图 k≥4 / 单图 ≥1024 visual token / 短文本 / 并发 ≤8（C=8 已吞吐饱和，加大并发只恶化 TTFT）。
# 不保证：k=1 长上下文旧画像（其最优为 chunked 8192）；更高复用率负载下 ③ 预取可能重新成立，未测。

# ---- GPU / 显存 ----
# KV 池 ≈ 935886 token / 28.6 GB（8 层 full-attn × 30516 B/token）；权重 8.62 GB（+ViT ~0.42 B）。
